{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageMetadata",
  "type": "object",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest": {
      "type": [
        "string",
        "null"
      ]
    },
    "mirrors": {
      "description": "Package-level public mirrors advertised by the publisher.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MirrorDescriptorV1"
      }
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "repo_url": {
      "type": "string"
    },
    "signing_keys": {
      "description": "Publisher keys consumers pin on first resolve.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PublisherKeyV1"
      }
    },
    "tags": {
      "description": "Free-form tags for filtering/discovery (multi-tag lookup).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vcs": {
      "$ref": "#/$defs/Vcs"
    },
    "version_scheme": {
      "description": "How this package's versions should be interpreted (semver by default).",
      "$ref": "#/$defs/VersionScheme"
    },
    "versions": {
      "description": "All published, non-yanked versions, newest first.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "org",
    "name",
    "vcs",
    "repo_url",
    "versions"
  ],
  "$defs": {
    "MirrorDescriptorV1": {
      "type": "object",
      "properties": {
        "alternate_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_prefix": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/MirrorKindV1",
          "default": "object-store"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "serves": {
          "$ref": "#/$defs/MirrorServesV1",
          "default": {
            "artifacts": true,
            "index": true,
            "metadata": true
          }
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MirrorKindV1": {
      "type": "string",
      "enum": [
        "zed-registry",
        "object-store",
        "directory",
        "github-release",
        "github-raw"
      ]
    },
    "MirrorServesV1": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "boolean",
          "default": true
        },
        "index": {
          "type": "boolean",
          "default": true
        },
        "metadata": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "PublisherKeyStateV1": {
      "type": "string",
      "enum": [
        "active",
        "retired",
        "revoked"
      ]
    },
    "PublisherKeyV1": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string"
        },
        "enrolled_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_id": {
          "type": "string"
        },
        "public_key_multibase": {
          "type": "string"
        },
        "revoked_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/PublisherKeyStateV1"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "public_key_multibase",
        "state"
      ]
    },
    "Vcs": {
      "description": "Version-control systems a package's source repository can live on.\n\nzed-pkg is VCS-agnostic by design: what gets installed is always a\nregistry artifact, and the VCS is where provenance (tags) is anchored.\nAuthors must create a matching tag on their declared backing repo\n(GitHub, GitLab, Bitbucket, Codeberg, SourceHut, Forgejo, Gitea, Azure\nDevOps, CodeCommit, Radicle, or self-hosted) before publishing.\n\n`jj` and Sapling are git-compatible and push to git remotes, so their\nprovenance is verified through git tags.",
      "type": "string",
      "enum": [
        "git",
        "hg",
        "jj",
        "sapling",
        "fossil",
        "pijul"
      ]
    },
    "VersionScheme": {
      "description": "How a package's `version` string (and its published tags) should be\ninterpreted. Defaults to [`VersionScheme::Semver`], which covers the vast\nmajority of modern ecosystems.",
      "oneOf": [
        {
          "description": "Semantic Versioning. `package.version` must be valid semver; ranges\n(`^1.2`, `>=0.2 <0.5`) resolve to the max satisfying stable version.",
          "type": "string",
          "const": "semver"
        },
        {
          "description": "Calendar Versioning (`2026.07.24`, `2026.07`). Normalized to a semver\ntotal order (leading zeros dropped, padded to major.minor.patch) so the\nsame range algebra applies. See [`normalize_calver`].",
          "type": "string",
          "const": "calver"
        },
        {
          "description": "Arbitrary tags (`release-candidate-1`, `legacy-api`). No range algebra:\na requirement must match a published version **exactly**.",
          "type": "string",
          "const": "opaque"
        }
      ]
    }
  }
}
