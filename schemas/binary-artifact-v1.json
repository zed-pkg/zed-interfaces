{
  "$defs": {
    "BinaryArchiveFormatV1": {
      "description": "Binary artifacts use ZIP exclusively in v1. ZIP is portable to Windows,\npreserves POSIX executable bits when present, and supports safe central-\ndirectory inspection before extraction.",
      "enum": [
        "zip"
      ],
      "type": "string"
    },
    "BinaryFileV1": {
      "additionalProperties": false,
      "description": "One regular payload file, addressed relative to `pkg/`.",
      "properties": {
        "executable": {
          "description": "Portable executable intent. Installers use this in addition to any ZIP\nUnix mode because Windows ZIP producers may not emit POSIX metadata.",
          "type": "boolean"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[^/\\\\:<>\"|?*\\u0000-\\u001f\\u007f]{1,255}(?:/[^/\\\\:<>\"|?*\\u0000-\\u001f\\u007f]{1,255})*$",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "executable"
      ],
      "type": "object"
    },
    "BinaryPackageIdentityV1": {
      "additionalProperties": false,
      "description": "Release identity stays independent from artifact/platform identity.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "type": "string"
        },
        "org": {
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
          "type": "string"
        }
      },
      "required": [
        "org",
        "name",
        "version"
      ],
      "type": "object"
    },
    "BinaryPlatformV1": {
      "additionalProperties": false,
      "description": "Normalized native platform selected for this one artifact.\n\n`target` is normally a Rust-style target triple such as\n`x86_64-unknown-linux-gnu`, but Zed treats it as an opaque normalized token\nso non-Rust toolchains can use their canonical spelling. `os`, `arch`,\n`libc`, and `abi` remain structured for resolver filtering.",
      "properties": {
        "abi": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        "arch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        "libc": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        "os": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "target",
        "os",
        "arch"
      ],
      "type": "object"
    },
    "BinarySourceProvenanceV1": {
      "additionalProperties": false,
      "description": "Optional source/VCS provenance carried inside the archive. The registry's\nsigned publication metadata remains the trust anchor; this is an inspectable\ncopy bound by the archive digest.",
      "properties": {
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "vcs_commit": {
          "maxLength": 128,
          "minLength": 7,
          "pattern": "^[A-Za-z0-9._+:/-]+$",
          "type": "string"
        },
        "vcs_tag": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "vcs_tag"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical integrity descriptor stored at `pkg/.zpkg-binary.json`.\n\n`files` contains every regular file except this descriptor itself. It must\ninclude `.zpkg.toml`. `entrypoints` must exactly mirror the package\nmanifest's `[bin]` table and each referenced file must be marked executable.",
  "properties": {
    "entrypoints": {
      "additionalProperties": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[^/\\\\:<>\"|?*\\u0000-\\u001f\\u007f]{1,255}(?:/[^/\\\\:<>\"|?*\\u0000-\\u001f\\u007f]{1,255})*$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!\\.)[A-Za-z0-9._+\\-]{1,128}$"
      },
      "type": "object"
    },
    "expanded_size": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BinaryFileV1"
      },
      "minItems": 2,
      "type": "array"
    },
    "format": {
      "$ref": "#/$defs/BinaryArchiveFormatV1",
      "default": "zip"
    },
    "package": {
      "$ref": "#/$defs/BinaryPackageIdentityV1"
    },
    "package_manifest": {
      "const": ".zpkg.toml",
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/BinaryPlatformV1"
    },
    "schema": {
      "const": "zpkg.binary-artifact/v1",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/BinarySourceProvenanceV1"
    }
  },
  "required": [
    "schema",
    "package",
    "platform",
    "package_manifest",
    "expanded_size",
    "files",
    "entrypoints"
  ],
  "title": "BinaryArtifactManifestV1",
  "type": "object"
}
