{
  "schema_version": "1.0.0",
  "service": "zed-api-server",
  "title": "zed-pkg registry, public CDN, and GitHub fallback routes",
  "version": "1.0.0",
  "description": "Typed RPC keys for github.com/zed-pkg. HTTP is the live registry wire. get_version also speaks TCP NDJSON (same JSON call/receipt as github.com/oresoftware/api-docs). CDN and GitHub paths are origin-relative: prepend https://cdn.zpkg.net or https://github.com. Generated by oresoftware/api-docs scripts/generate-routes.py.",
  "map": {
    "healthz": "/healthz",
    "get_package": {
      "path": "/v1/packages/{org}/{name}",
      "methods": ["GET"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org", "name"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "get_version": {
      "path": "/v1/packages/{org}/{name}/versions/{version}",
      "methods": ["GET", "PUT"],
      "transports": ["http", "tcp"],
      "tcp_framing": "ndjson",
      "summary": "GET metadata for one version; PUT publishes it. TCP carries the same JSON unary as HTTP.",
      "path_params": {
        "type": "object",
        "required": ["org", "name", "version"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "get_artifact": {
      "path": "/v1/artifacts/{sha256}",
      "methods": ["GET"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "search": {
      "path": "/v1/search",
      "methods": ["GET"],
      "transports": ["http"],
      "query_schema": {
        "type": "object",
        "properties": {
          "q": { "type": "string" },
          "tag": { "type": "array", "items": { "type": "string" } },
          "limit": { "type": "integer" }
        }
      }
    },
    "list_packages": {
      "path": "/v1/packages",
      "methods": ["GET"],
      "transports": ["http"]
    },
    "semantic_search": {
      "path": "/v1/search/semantic",
      "methods": ["POST"],
      "transports": ["http"]
    },
    "upsert_embedding": {
      "path": "/v1/packages/{org}/{name}/embedding",
      "methods": ["PUT"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org", "name"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "get_file": {
      "path": "/v1/files/{org}/{name}/{version}/{path}",
      "methods": ["GET"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org", "name", "version", "path"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "yank": {
      "path": "/v1/packages/{org}/{name}/versions/{version}/yank",
      "methods": ["POST"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org", "name", "version"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "claim_org": {
      "path": "/v1/orgs",
      "methods": ["POST"],
      "transports": ["http"]
    },
    "get_audit": {
      "path": "/v1/orgs/{org}/audit",
      "methods": ["GET"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org"],
        "properties": {
          "org": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verify_audit": {
      "path": "/v1/orgs/{org}/audit/verify",
      "methods": ["GET"],
      "transports": ["http"],
      "path_params": {
        "type": "object",
        "required": ["org"],
        "properties": {
          "org": { "type": "string", "minLength": 1 }
        }
      }
    },
    "registry_events": {
      "path": "/v1/ws",
      "methods": ["GET"],
      "transports": ["websocket"],
      "summary": "HTTP upgrade. Subsequent text frames are rpc-call / rpc-receipt JSON keyed by this map."
    },
    "cdn_github_object": {
      "path": "/github/{owner}/{repo}/{tag}/{filename}",
      "methods": ["GET"],
      "transports": ["http"],
      "summary": "Guessable public R2 object on cdn.zpkg.net from a GitHub identity.",
      "path_params": {
        "type": "object",
        "required": ["owner", "repo", "tag", "filename"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "tag": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cdn_package_object": {
      "path": "/packages/{org}/{name}/{version}/{filename}",
      "methods": ["GET"],
      "transports": ["http"],
      "summary": "Guessable public R2 object on cdn.zpkg.net from a Zed org/name/version.",
      "path_params": {
        "type": "object",
        "required": ["org", "name", "version", "filename"],
        "properties": {
          "org": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cdn_content_object": {
      "path": "/artifacts/{sha256}.{ext}",
      "methods": ["GET"],
      "transports": ["http"],
      "summary": "Canonical content-addressed R2 object. The version row artifact_key stays this shape; github/ and packages/ keys are extra copies.",
      "path_params": {
        "type": "object",
        "required": ["sha256", "ext"],
        "properties": {
          "sha256": { "type": "string", "minLength": 1 },
          "ext": { "type": "string", "minLength": 1 }
        }
      }
    },
    "github_release_asset": {
      "path": "/{owner}/{repo}/releases/download/{tag}/{asset}",
      "methods": ["GET"],
      "transports": ["http"],
      "summary": "Packed GitHub Release asset (origin https://github.com). Last packed fallback before a source archive.",
      "path_params": {
        "type": "object",
        "required": ["owner", "repo", "tag", "asset"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "minLength": 1 },
          "tag": { "type": "string", "minLength": 1 },
          "asset": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
